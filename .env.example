# aiping.cn OpenAI 兼容接口（视觉识别推荐配置）
DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_BASE_URL=https://aiping.cn/api/v1
VISION_MODEL=Qwen3-VL-30B-A3B-Instruct
VISION_FALLBACK_MODELS=Qwen2.5-VL-72B-Instruct,Qwen3-VL-235B-A22B-Instruct

# 视频/音频 Omni 需要支持 input_audio 的模型；aiping 当前未发现 qwen-omni，可回退 DashScope 或单独配置兼容模型。
OMNI_MODEL=qwen3.5-omni-plus
LLM_THINKING=false
LLM_JSON_MODE=true

GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=yujianji/0.1 (+https://github.com/SevenAILab/yujianji)
