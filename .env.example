# ── 模型 ──────────────────────────────────────────────────────────
# OpenAI 兼容接口。线上必须与本文件一致，别让下一个人再猜一遍。
# ⚠️ 主战场在国内时，必须使用境内已备案的模型，不要指向 OpenAI/gpt-4o。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus
# 主模型被限流时按顺序降级，逗号分隔，可留空
VISION_FALLBACK_MODELS=
# 视频链路需要支持 input_audio 的 omni 模型，换成纯视觉模型会丢掉"边拍边说"的语音
OMNI_MODEL=qwen3.5-omni-plus
LLM_THINKING=false
LLM_JSON_MODE=true

# ── 用量护栏 ──────────────────────────────────────────────────────
# 不配 Upstash 时限流退回单实例内存：单机部署够用，
# Vercel 这类多实例部署下不是全局限流，务必配上。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 全站每日模型调用上限，超过后所有花钱接口返回 503
DAILY_CALL_BUDGET=500
DEVICE_HOURLY_LIMIT=20
DEVICE_DAILY_LIMIT=60
GLOBAL_HOURLY_LIMIT=300

# ── 地点服务 ──────────────────────────────────────────────────────
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=yujianji/0.2 (+https://github.com/SevenAILab/yujianji)

# ── 原生壳（Capacitor）─────────────────────────────────────────────
# 只有打包 App 时才需要：页面从 capacitor://localhost 加载，接口要打绝对地址。
# Web 端留空 → 走相对路径，行为不变。
NEXT_PUBLIC_API_BASE=

# ── 遇见手记 ──────────────────────────────────────────────────────
# 遇见手记必须走阿里云百炼（语音识别 fun-asr 只有百炼有）。
# 国内站的 DASHSCOPE_* 指向的是 Agnes（拍照链路），所以这里单独给一组；不配才回落到 DASHSCOPE_*。
MEMO_API_KEY=
MEMO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 语音识别：S0 第 5 项 9/16 实测 dashscope.aliyuncs.com 可用（不需要换 WorkspaceId 地址）
MEMO_ASR_MODEL=fun-asr
MEMO_ASR_BASE_URL=https://dashscope.aliyuncs.com
MEMO_TRIAGE_MODEL=qwen3.5-flash
MEMO_AGENT_MODEL=qwen3.5-plus
MEMO_WRITER_MODEL=qwen3.5-plus
MEMO_VERIFIER_MODEL=qwen3.5-plus
MEMO_REFLECT_MODEL=qwen3-max
MEMO_FACT_MODEL=qwen3.5-plus
MEMO_ENABLE_SEARCH=true
# S0 第 7 项：带工具时 DashScope 忽略 response_format（json_schema / json_object 都 0/10），
# 判断改用"交卷工具"（10/10）；无工具的写作、自查、反思走 json_object + 代码修复。保持 false。
MEMO_STRUCTURED_OUTPUTS=false
MEMO_MAX_AGENT_STEPS=6
MEMO_MAX_TOOL_CALLS=4
# 单进程内存计数，超出返回 BUDGET_EXCEEDED；演示前可调高
MEMO_DAILY_BUDGET_YUAN=20
# 遇见手记接口独立计数，不占拍照链路的 DEVICE_HOURLY_LIMIT（一场录音的分块、轮询、逐窗口判断会超过 20 次/小时）
MEMO_DEVICE_HOURLY_LIMIT=150
MEMO_DAILY_CALL_BUDGET=3000
MEMO_LIGHT_HOURLY_LIMIT=3000

# ── 可切换的模型服务商（外部设备接入工单 v2 Gate 0，实验项） ──────────
# 百炼额度用完时，判断/写作和识图可以切到智谱免费模型；切回只要把下面两项改回 dashscope。
# 语音识别不受影响，永远走百炼（MEMO_API_KEY）。智谱没有联网搜索，事实补充会自动跳过。
MEMO_LLM_PROVIDER=dashscope
VISION_PROVIDER=dashscope
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 文字模型：统一用 ZHIPU_TEXT_MODEL，按角色覆盖用 ZHIPU_<ROLE>_MODEL（TRIAGE/AGENT/WRITER/VERIFIER/REFLECT/FACT）
ZHIPU_TEXT_MODEL=glm-4.5-flash
ZHIPU_VISION_MODEL=glm-4.6v-flash
# 智谱免费模型并发 2 就会 429：全进程同时只跑这么多个模型调用（0 = 不限，千问保持 0）
MEMO_MODEL_CONCURRENCY=0
# 排队最长等多久（毫秒），超过按限流失败
MEMO_MODEL_QUEUE_WAIT_MS=120000
# 429 / 5xx 的重试次数（指数退避）。智谱建议 3
MEMO_MODEL_MAX_RETRIES=1
# 单次 HTTP 请求超时（毫秒），与整轮截止时间并存
MEMO_REQUEST_TIMEOUT_MS=60000
# 判断一个窗口的整轮截止时间（毫秒）。千问 45 秒够用；智谱免费模型判断真实长窗口要 34–45 秒，建议 90000
MEMO_JUDGE_DEADLINE_MS=45000
# 写手帐的整轮预算和草稿那一步的上限（毫秒）。千问 50000 / 30000；智谱建议 100000 / 60000
MEMO_WRITE_BUDGET_MS=50000
MEMO_WRITE_DRAFT_MS=30000
FFMPEG_PATH=ffmpeg
MEMO_TMP_DIR=/tmp/yujianji-memo
# 仅本机 eval 离线对比 Claude / GPT（OpenAI 兼容端点）用，不进产品链路：npm run eval:memo -- --provider eval --model <id>
MEMO_EVAL_BASE_URL=
MEMO_EVAL_API_KEY=
# 照片建模后端：仅服务端读取，禁止使用 NEXT_PUBLIC_ 前缀。
MEMORY_3D_API_URL=http://127.0.0.1:8000
MEMORY_3D_SERVICE_KEY=
